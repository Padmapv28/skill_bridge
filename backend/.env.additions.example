# New variables for the job-openings step. Add to your .env locally and to your host's environment in production.
# Free keys: https://developer.adzuna.com  (leave blank to run with search links only)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna country code (in = India, gb, us, ca, au, sg ...)
JOBS_COUNTRY=in
JOBS_DEFAULT_LOCATION=
JOBS_CACHE_TTL_SECONDS=1800
JOBS_TIMEOUT_SECONDS=8
